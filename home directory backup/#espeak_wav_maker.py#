import os
import sys
import argparse
from datetime import datetime

def say(text):
    os.popen('espeak -ven-us "' + text + '" --stdout | aplay 2>/dev/null')

def create_wav(text, file_name):
    os.popen('espeak -ven-us -s 1 "' + text + '" --stdout > ' + file_name)
    
def main():
    # set up argument parser
    parser = argparse.ArgumentParser(description='Uses TTS to convert STDIN to a .wav file.')
    parser.add_argument('-i', '--input', nargs='?', type=str, help='The file whose contents should be converted to speech')
    parser.add_argument('-o', '--output', nargs='?', type=str, help='The file name to output audio to (default: current datetime)')
    parser.add_argument('text', nargs='*', type=str, help='The text to be converted to speech')
    args = parser.parse_args()

    # if input file specified, read in the contents
    text = ''
    if(args.input):
        with open(args.input, 'r') as file:
            text += file.read().replace('\n', ' ')
    if(args.text):
        text += str(' '.join(args.text))
        
        
    # if output file not specified, get current date and time for naming .wav output file
    if(args.output):
        out_file = args.output
    else:
        now = datetime.now()
        out_file = now.strftime("%d-%m-%Y_%H:%M:%S:%f") + '.wav'
    print('creating ' + out_file)

    # make espeak wav of given text
    create_wav(text, out_file)
    #read back file out loud 
    #say(text)
    #os.popen('aplay ' + out_file)

main()
